[Unit]
Description=MacFeel mouse acceleration daemon
Documentation=file:///usr/share/doc/macfeel/README.md
After=systemd-udevd.service
# A crash loop must not keep the mouse in a broken state: give up after 5 tries.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/macfeeld
Restart=on-failure
RestartSec=2
Nice=-5

# Least privilege: own system user; access to mice and /dev/uinput only via
# the ACLs set by /usr/lib/udev/rules.d/70-macfeel.rules.
User=macfeel
Group=macfeel
StateDirectory=macfeel
RuntimeDirectory=macfeel
RuntimeDirectoryMode=0755

DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw

# No network. (Not PrivateNetwork=yes: udev's hotplug events arrive over a
# netlink socket that a private network namespace would never receive.)
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
