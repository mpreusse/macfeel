[Unit]
Description=MacFeel mouse acceleration daemon
Documentation=file:///usr/share/doc/macfeel/README.md
After=systemd-udevd.service
# A crash loop must not keep the mouse in a broken state: give up after 5 tries.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/macfeeld
Restart=on-failure
RestartSec=2
Nice=-5

# Own system user. Device access comes from the "input" group (input devices
# and, via 70-macfeel.rules, /dev/uinput). The kernel would allow keyboards
# too; MacFeel only ever opens devices udev tags as mice (see devices.py and
# docs/decisions.md). Per-user ACLs were tried and don't survive logind's
# uaccess resets.
User=macfeel
Group=macfeel
SupplementaryGroups=input
StateDirectory=macfeel
RuntimeDirectory=macfeel
RuntimeDirectoryMode=0755

DevicePolicy=closed
DeviceAllow=char-input rw
DeviceAllow=/dev/uinput rw

# No network. (Not PrivateNetwork=yes: udev's hotplug events arrive over a
# netlink socket that a private network namespace would never receive.)
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
