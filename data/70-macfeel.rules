# MacFeel: the daemon runs with the "input" group (see macfeeld.service).
# Input event devices are root:input 0660 by default; /dev/uinput is root-only
# on Ubuntu, so open it to the "input" group as well, which is what Toshy's
# rule does too. Needed to create the virtual mice.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660"
