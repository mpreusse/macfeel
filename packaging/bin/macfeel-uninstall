#!/bin/bash
# Remove MacFeel completely and put GNOME's mouse settings back.
# Run as your normal user; sudo is used once, for apt.
set -euo pipefail
say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
[ "$(id -u)" -ne 0 ] || { echo "Run as your normal user (not root)." >&2; exit 1; }

# 1. Stop the tray (as the user) and restore GNOME's mouse acceleration from
#    the backup MacFeel made (gsettings is per user, so this can't be done by apt).
pkill -u "$(id -u)" -f "macfeel.tray" 2>/dev/null || true
BACKUP="${XDG_CONFIG_HOME:-$HOME/.config}/macfeel/gnome-backup.json"
if [ -f "$BACKUP" ]; then
    say "Restoring GNOME mouse settings"
    python3 - "$BACKUP" <<'PY'
import json, subprocess, sys
saved = json.load(open(sys.argv[1]))
schema = "org.gnome.desktop.peripherals.mouse"
subprocess.run(["gsettings", "set", schema, "accel-profile", saved.get("accel-profile", "default")], check=True)
subprocess.run(["gsettings", "set", schema, "speed", str(saved.get("speed", 0.0))], check=True)
PY
fi
rm -rf "${XDG_CONFIG_HOME:-$HOME/.config}/macfeel"

# 2. Remove the package with everything it created: service, udev rule and
#    ACLs, the "macfeel" system user, /var/lib/macfeel and /etc/macfeel.
say "Removing the package (sudo)"
sudo apt-get purge -y macfeel
say "MacFeel is uninstalled. Your mouse is back to GNOME's own settings."
